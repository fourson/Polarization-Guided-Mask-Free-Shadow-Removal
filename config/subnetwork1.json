{
  "name": "default",
  "n_gpu": 4,
  "module": "subnetwork1",
  "data_loader": {
    "type": "TrainDataLoader",
    "args": {
      "data_dir": "data/train",
      "batch_size": 4,
      "shuffle": true,
      "validation_split": 0.1,
      "num_workers": 4
    }
  },
  "model": {
    "type": "DefaultModel",
    "args": {
      "init_dim": 32,
      "norm_type": "instance",
      "use_dropout": false
    }
  },
  "loss": {
    "type": "m_loss",
    "args": {
      "l1_loss_lambda": 10,
      "l2_loss_lambda": 100,
      "perceptual_loss_lambda": 0.1,
      "gradient_loss_lambda": 10
    }
  },
  "metrics": [
    "psnr",
    "ssim"
  ],
  "optimizer": {
    "type": "Adam",
    "args": {
      "lr": 0.01,
      "betas": [
        0.5,
        0.999
      ],
      "weight_decay": 0,
      "amsgrad": true
    }
  },
  "lr_scheduler": {
    "type": "MultiplicativeLR",
    "args": {
      "lr_lambda_tag": "subnetwork1"
    }
  },
  "trainer": {
    "type": "DefaultTrainer",
    "args": {
      "epochs": 100,
      "save_dir": "saved_subnetwork1",
      "save_period": 20,
      "verbosity": 2,
      "monitor": "off",
      "tensorboardX": true,
      "log_dir": "saved_subnetwork1/runs"
    }
  }
}
